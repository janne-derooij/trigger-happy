# Copy the contents of this file into Streamlit Community Cloud:
#   your app -> Settings -> Secrets
# Locally you can save it as .streamlit/secrets.toml (it is git-ignored),
# or leave it out entirely to use a local SQLite file.

admin_password = "choose-a-password"

# Public address of the deployed app (used for the QR code on the Join screen)
app_url = "https://your-app-name.streamlit.app"

[database]
# Supabase -> your project -> Connect -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password (URL-encode special characters).
url = "postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
